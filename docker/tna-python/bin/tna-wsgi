#!/bin/bash

set -e

echo "Starting application..."
echo

# Get the application
APPLICATION=$1

# Error if no application is passed
if [ -z "$APPLICATION" ]
then
  echo -e "Error: application not specified\n"
  echo "PARAMETERS"
  echo "  application          the Python package you want to run"
  echo "                       Examples: tna-wsgi my_app:app"
  echo "                                 tna-asgi my_app:app"
  exit 1
fi

GUNICORN_CONF="/home/app/gunicorn.conf.py"
# Use an application-specific configuration when one is provided
if [ -f "/app/gunicorn.conf.py" ]
then
  GUNICORN_CONF="/app/gunicorn.conf.py"
fi

if [ ! -f $GUNICORN_CONF ]
then
  echo "Error: gunicorn config $GUNICORN_CONF not found"
  exit 1
fi

echo "Using $GUNICORN_CONF for configuration..."
echo
poetry run gunicorn --check-config --config "$GUNICORN_CONF" "$APPLICATION"

CPU_CORES=$(nproc)
CONFIGURED_WORKERS=$(python3 -c "
ns = {}
exec(open('$GUNICORN_CONF').read(), ns)
print(ns['workers'])
")
MEMORY_LIMIT=$(cat /sys/fs/cgroup/memory.max)
if [ "$MEMORY_LIMIT" = "max" ]
then
  MEMORY_LIMIT=$(grep MemTotal /proc/meminfo | awk '{print $2 * 1024}')
fi
MEMORY_LIMIT_MB=$((MEMORY_LIMIT / 1024 / 1024))
ESTIMATED_USAGE=$((CONFIGURED_WORKERS * 100))  # 100MB per worker estimate
echo "CPU cores:                         $CPU_CORES"
echo "Configured workers:                ${CONFIGURED_WORKERS}"
echo "Estimated usage at (100MB/worker): ${ESTIMATED_USAGE}MB"
echo "Total memory:                      ${MEMORY_LIMIT_MB}MB"
echo
if [ $CONFIGURED_WORKERS -gt $((CPU_CORES * 3)) ]; then
  echo "⚠️  WARNING: Too many workers ($CONFIGURED_WORKERS) for available cores ($CPU_CORES)"
  echo "    Recommended:"
  echo "      $((CPU_CORES * 2)) workers for I/O-bound apps"
  echo "      $(((CPU_CORES * 2) + 1)) workers for CPU-bound apps"
  echo
fi
if [ $ESTIMATED_USAGE -gt $((MEMORY_LIMIT_MB / 10 * 8)) ]; then  # 80% of total memory
  echo "⚠️  WARNING: Estimated memory usage may exceed available memory"
  echo
fi

APPLICATION_PROTOCOL=$(echo "${APPLICATION_PROTOCOL:-https}" | tr '[:upper:]' '[:lower:]')
if [ "$APPLICATION_PROTOCOL" = "https" ]
then
  source tna-ssl-setup
  export SSL_KEY_FILE SSL_CERTIFICATE_FILE
elif [ "$APPLICATION_PROTOCOL" != "http" ]
then
  echo -e "Error: invalid protocol specified in APPLICATION_PROTOCOL: '$APPLICATION_PROTOCOL'\n"
  echo "Allowed values are 'http' and 'https'"
  exit 1
fi

poetry run gunicorn --config "$GUNICORN_CONF" "$APPLICATION"
